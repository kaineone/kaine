[Unit]
Description=KAINE vector store (Qdrant)

[Container]
ContainerName=kaine-qdrant
Image=docker.io/qdrant/qdrant:v1.18.0
Network=kaine.network
PublishPort=127.0.0.1:6533:6333
Volume=kaine-qdrant-data.volume:/qdrant/storage
Environment=QDRANT__SERVICE__API_KEY=${KAINE_QDRANT_API_KEY}
Environment=QDRANT__TELEMETRY_DISABLED=true
# Connectivity-only probe: the qdrant:v1.18.0 image ships neither curl nor
# wget, so we use bash /dev/tcp. This matches compose/kaine.yml and verifies
# the HTTP port is bound; it does not assert /readyz returns 200.
HealthCmd=bash -c 'exec 3<>/dev/tcp/127.0.0.1/6333'
HealthInterval=10s
HealthRetries=5

[Service]
Restart=always

[Install]
WantedBy=default.target
