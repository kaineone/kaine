[Unit]
Description=KAINE decision model server (K1-Jev on /v1/systemone)
Requires=kaine-redis.service
After=kaine-redis.service

[Container]
ContainerName=kaine-decision-model
# llama.cpp build b11382 pinned by digest; bumps change this file, compose/kaine*.yml and the trainer converter together.
Image=ghcr.io/ggml-org/llama.cpp@sha256:ef08b5a98b1170f2b62177be0a4027c88a84043c55afbf190dd18b9e7cdcfebf
Network=kaine.network
PublishPort=127.0.0.1:11436:8080
Volume=kaine-models.volume:/models:ro
# Rootless NVIDIA via CDI — requires `nvidia-ctk cdi generate` (see README).
AddDevice=nvidia.com/gpu=0
SecurityLabelDisable=true
# Unlike the organ, the decision server does not hot-swap adapters, so it
# runs llama-server directly. Idle-unload, GPU layers, cache, context and
# parallel slots are validated inside the container's sh wrapper.
PodmanArgs=--entrypoint=/bin/sh
Environment=KAINE_DECISION_SERVER_SLEEP_IDLE_SECONDS=${KAINE_DECISION_SERVER_SLEEP_IDLE_SECONDS}
Environment=KAINE_DECISION_SERVER_NGL=${KAINE_DECISION_SERVER_NGL}
Environment=KAINE_DECISION_SERVER_CACHE_RAM_MIB=${KAINE_DECISION_SERVER_CACHE_RAM_MIB}
Environment=KAINE_DECISION_SERVER_CTX=${KAINE_DECISION_SERVER_CTX}
Environment=KAINE_DECISION_SERVER_PARALLEL=${KAINE_DECISION_SERVER_PARALLEL}
Exec=-c 's="$${KAINE_DECISION_SERVER_SLEEP_IDLE_SECONDS:-600}"; if ! echo "$$s" | grep -Eqx -- "-1|[0-9]+"; then echo "KAINE_DECISION_SERVER_SLEEP_IDLE_SECONDS must be an integer of -1 or more" >&2; exit 64; fi; n="$${KAINE_DECISION_SERVER_NGL:-999}"; case "$$n" in ""|*[!0-9]*) echo "KAINE_DECISION_SERVER_NGL must be a non-negative integer" >&2; exit 64;; esac; c="$${KAINE_DECISION_SERVER_CACHE_RAM_MIB:-512}"; case "$$c" in ""|*[!0-9]*) echo "KAINE_DECISION_SERVER_CACHE_RAM_MIB must be a non-negative integer" >&2; exit 64;; esac; x="$${KAINE_DECISION_SERVER_CTX:-4096}"; case "$$x" in ""|0*|*[!0-9]*) echo "KAINE_DECISION_SERVER_CTX must be a positive integer" >&2; exit 64;; esac; p="$${KAINE_DECISION_SERVER_PARALLEL:-2}"; case "$$p" in ""|0*|*[!0-9]*) echo "KAINE_DECISION_SERVER_PARALLEL must be a positive integer" >&2; exit 64;; esac; exec /app/llama-server --model /models/K1-Jev-0.8B/K1-Jev-0.8B-Q8_0.gguf --alias k1-jev --host 0.0.0.0 --port 8080 --sleep-idle-seconds "$$s" --fit off -ngl "$$n" --cache-ram "$$c" -c "$$x" -np "$$p" -ctk f16 -ctv f16'
HealthCmd=curl -fsS http://127.0.0.1:8080/health
HealthInterval=15s
HealthRetries=10

[Service]
EnvironmentFile=@KAINE_ROOT@/compose/.env
Restart=always

[Install]
WantedBy=default.target
