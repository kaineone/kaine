# Caretaker bearer tokens for compose container deployments.
#
# Copy this file to compose/caretaker.env, chmod 600 it, and set one
# KAINE_CARETAKER_TOKEN_<NAME>=... line per [[caretaker.channels]] token_name,
# upper-cased. The cycle and study containers load compose/caretaker.env via
# env_file; native (non-container) runs can keep the same tokens in
# config/secrets.toml under [caretaker.tokens] instead.
#
# KAINE_CARETAKER_TOKEN_NTFY=replace-me
