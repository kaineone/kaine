% Sources for the individuation measurement rebuild design (researched 2026-10-03).
% Each entry's note says what it supports and how much of it was read.
% Not consulted: Good, Permutation, Parametric and Bootstrap Tests of Hypotheses (named in the brief; not read, not cited).

@article{gretton2012,author={Gretton, Arthur and Borgwardt, Karsten M. and Rasch, Malte J. and Sch{\"o}lkopf, Bernhard and Smola, Alexander},year={2012},title={A Kernel Two-Sample Test},journal={Journal of Machine Learning Research},volume={13},number={25},pages={723--773},url={https://jmlr.org/papers/v13/gretton12a.html},note={Abstract only. MMD as the largest difference in expectations over the unit ball of an RKHS; two-sample tests built on it; quadratic-time statistic. Supports placing the energy test in the kernel two-sample family and the Gaussian-MMD alternative.}}
@article{sejdinovic2013,author={Sejdinovic, Dino and Sriperumbudur, Bharath and Gretton, Arthur and Fukumizu, Kenji},year={2013},title={Equivalence of distance-based and RKHS-based statistics in hypothesis testing},journal={Annals of Statistics},volume={41},number={5},pages={2263--2291},url={https://arxiv.org/abs/1207.6076},note={Abstract only. Energy distance with a negative-type semimetric equals MMD with the distance kernel; other kernels in the family can be more powerful. Supports the energy/MMD equivalence and the MMD comparison in the simulation.}}
@article{rizzo2016,author={Rizzo, Maria L. and Sz{\'e}kely, G{\'a}bor J.},year={2016},title={Energy distance},journal={WIREs Computational Statistics},volume={8},number={1},pages={27--38},doi={10.1002/wics.1375},url={https://pages.stat.wisc.edu/~wahba/stat860public/pdf4/Energy/EnergyDistance10.1002-wics.1375.pdf},note={Full text pp. 27-30. Energy distance zero iff F=G; two-sample E-statistic 2A-B-C; T consistent, implemented as a permutation test; energy coefficient H in [0,1], zero iff identically distributed (p. 29); characterization fails for exponent alpha=2 (zero whenever means agree), basis for requiring Euclidean not 1-cos (p. 29); consistency for 0<alpha<2 (p. 30).}}
@article{szekely2017,author={Sz{\'e}kely, G{\'a}bor J. and Rizzo, Maria L.},year={2017},title={The Energy of Data},journal={Annual Review of Statistics and Its Application},doi={10.1146/annurev-statistics-060116-054026},url={https://pages.stat.wisc.edu/~wahba/stat860public/pdf4/Energy2/ARSIA-final-sub.pdf},note={Read the submitted manuscript pp. 1-10 and 15-16. U- versus V-statistic forms (pp. 6-7); Definition 1 and Proposition 1 (energy distance nonnegative, zero iff identically distributed, rotation invariant); section 6.1 two-sample statistic and permutation implementation. Volume and pages not checked, so omitted.}}
@inproceedings{lopezpaz2017,author={Lopez-Paz, David and Oquab, Maxime},year={2017},title={Revisiting Classifier Two-Sample Tests},booktitle={International Conference on Learning Representations (ICLR)},url={https://arxiv.org/abs/1610.06545},note={Abstract and pp. 1-2. C2ST: accuracy of a classifier on a held-out subset; interpretable units, simple null. Supports the considered-and-rejected alternative (needs a split of small samples).}}
@article{shekhar2024,author={Shekhar, Shubhanshu and Ramdas, Aaditya},year={2024},title={Nonparametric Two-Sample Testing by Betting},journal={IEEE Transactions on Information Theory},volume={70},number={2},pages={1178--1203},doi={10.1109/TIT.2023.3305867},url={https://arxiv.org/abs/2112.09162},note={Read arXiv v6 pp. 1-4 and 19-20. Sequential two-sample test from two independent i.i.d. streams; reject when wealth >= 1/alpha, type-I control via Ville's inequality; section 5.1 time-varying two-sample testing where permutation tests are inapplicable. Supports the v2 sequential path (needs fresh draws from both arms). Journal volume/pages from the ACM DL search result, not the publisher page.}}
@article{vovk2021,author={Vovk, Vladimir and Wang, Ruodu},year={2021},title={E-values: Calibration, combination and applications},journal={Annals of Statistics},volume={49},number={3},pages={1736--1754},url={https://arxiv.org/abs/1912.06116},note={Read arXiv v4 pp. 1-5. E-variable definition (E[E]<=1 under null); p-to-e calibrators, family kappa p^(kappa-1); convex mixtures of e-values are e-values without assumptions on dependence; products of independent or sequential e-values are e-values. Supports the e-value combination alternative.}}
@article{howard2021,author={Howard, Steven R. and Ramdas, Aaditya and McAuliffe, Jon and Sekhon, Jasjeet},year={2021},title={Time-uniform, nonparametric, nonasymptotic confidence sequences},journal={Annals of Statistics},volume={49},number={2},pages={1055--1080},url={https://arxiv.org/abs/1810.08240},note={Abstract only. Confidence sequences are uniformly valid over an unbounded horizon. Cited only as a possible later time-uniform interval for the effect size.}}
@article{phipson2010,author={Phipson, Belinda and Smyth, Gordon K.},year={2010},title={Permutation P-values Should Never Be Zero: Calculating Exact P-values When Permutations Are Randomly Drawn},journal={Statistical Applications in Genetics and Molecular Biology},volume={9},number={1},pages={Article 39},doi={10.2202/1544-6115.1585},url={https://arxiv.org/abs/1603.05766},note={Read arXiv version pp. 1-7. Permutation tests assume i.i.d. observations under H0; b/m understates p and inflates type I error, dangerous with small thresholds and multiple testing (sections 2-3); exact Monte Carlo/permutation p-value (b+1)/(m+1) (sections 4-5), slightly conservative when drawn with replacement (section 6).}}
@article{ernst2004,author={Ernst, Michael D.},year={2004},title={Permutation Methods: A Basis for Exact Inference},journal={Statistical Science},volume={19},number={4},doi={10.1214/088342304000000396},url={https://projecteuclid.org/journals/statistical-science/volume-19/issue-4/Permutation-Methods-A-Basis-for-Exact-Inference/10.1214/088342304000000396.full},note={Abstract only (full text paywalled). Permutation methods give exact, distribution-free inference. Background citation only.}}
@article{lan1983,author={Lan, K. K. Gordon and DeMets, David L.},year={1983},title={Discrete sequential boundaries for clinical trials},journal={Biometrika},volume={70},number={3},pages={659--663},doi={10.1093/biomet/70.3.659},url={https://academic.oup.com/biomet/article-abstract/70/3/659/249328},note={Abstract only. Alpha-spending function; the boundary at a decision time does not depend on future decision times or their total number. Supports framing repeated looks as spending a lifetime error budget.}}
@inproceedings{gao2025,author={Gao, Irena and Liang, Percy and Guestrin, Carlos},year={2025},title={Model Equality Testing: Which Model Is This API Serving?},booktitle={International Conference on Learning Representations (ICLR)},url={https://arxiv.org/abs/2410.20247},note={Read arXiv v2 pp. 1-5. Two-sample MMD tests on LLM completions, including drift of an endpoint over time; kernel with a prompt indicator giving an expectation over prompts of per-prompt MMD; null by simulation or permutation; median 77.4 percent power with about 10 samples per prompt over 20-25 prompts at alpha 0.05. Supports the per-prompt statistic and the sample-size starting point.}}
@inproceedings{ramdas2015,author={Ramdas, Aaditya and Reddi, Sashank J. and P{\'o}czos, Barnab{\'a}s and Singh, Aarti and Wasserman, Larry},year={2015},title={On the decreasing power of kernel and distance based nonparametric hypothesis tests in high dimensions},url={https://arxiv.org/abs/1406.2083},note={Abstract only. Power of kernel and distance tests drops polynomially with dimension against fair alternatives. Supports caution on power in 384-d and the need for simulation. Venue (AAAI 2015) not checked.}}
@inproceedings{rabanser2019,author={Rabanser, Stephan and G{\"u}nnemann, Stephan and Lipton, Zachary C.},year={2019},title={Failing Loudly: An Empirical Study of Methods for Detecting Dataset Shift},booktitle={Advances in Neural Information Processing Systems (NeurIPS)},url={https://arxiv.org/abs/1810.11953},note={Abstract only. Two-sample testing on learned representations performed best for shift detection. Background for testing on embeddings.}}
@misc{minilm_card,author={{sentence-transformers}},title={all-MiniLM-L6-v2 model card},howpublished={Hugging Face},url={https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2},note={Model card read (2026-10-03). Input longer than 256 word pieces is truncated; 384-d; intended as a sentence and short paragraph encoder. Supports per-response embedding and the truncation defect.}}
@misc{llamacpp_server,author={{ggml-org}},title={llama.cpp server README},howpublished={GitHub},url={https://github.com/ggml-org/llama.cpp/blob/master/tools/server/README.md},note={Relevant sections read (2026-10-03). seed option (default -1 random); cache_prompt can make results nondeterministic because logits differ across batch sizes; per-request lora list with id and scale; -np slots; /v1/chat/completions also accepts /completion-specific features. Whether seed is honoured on that endpoint is not stated explicitly; verify in the smoke test.}}
